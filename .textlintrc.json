{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "/^\\+\\+\\+$[\\s\\S]*?^\\+\\+\\+$/m"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "no-exclamation-question-mark": false,
      "max-ten": {
        "max": 2,
        "strict": true
      }
    },
    "preset-ja-spacing": {
      "ja-space-around-code": false,
      "ja-space-around-link": false
    },
    "prh": {
      "rulePaths": [
        "prh-ai.yml",
        "prh-style.yml"
      ]
    }
  }
}
