{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "/^\\+\\+\\+$[\\s\\S]*?^\\+\\+\\+$/m"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "no-exclamation-question-mark": false,
      "max-ten": {
        "max": 1,
        "isStrict": true
      }
    },
    "preset-ja-spacing": true,
    "prh": {
      "rulePaths": [
        "prh.yml"
      ]
    }
  }
}
